# Copy to tools/fleet/fleet.env (git-ignored) and fill in, or set these in the environment.
# AWS: credentials and profile as the AWS CLI and boto3 find them (e.g. AWS_PROFILE).
FLEET_REGION=<aws region>
FLEET_SUBNET=<subnet id the workers start in>
FLEET_SECURITY_GROUPS=<security group id(s), space separated>
FLEET_INSTANCE_PROFILE=<instance profile name whose role lets SSM manage the VM>
# Optional: the Name tag, more tags as "{Key=k,Value=v},{Key=k2,Value=v2}", hours before a worker shuts itself down.
FLEET_NAME=cua-driver-bench-fleet
FLEET_TAGS=
FLEET_MAX_HOURS=12
# Optional: the framework the workers install, and the bench they clone.
FLEET_FRAMEWORK=agentenv-framework==0.9.1412
FLEET_BENCH_REPO=https://github.com/earakely-scale/agentenv-cua-driver-bench
# The model endpoint the agents call (OpenAI-compatible, e.g. a LiteLLM proxy). Keep its key out of this file:
# export FLEET_MODEL_KEY in the shell that runs start.py.
FLEET_MODEL_BASE_URL=<https://your-model-proxy>
# Optional: the Hugging Face dataset the workers upload to (huggingface_hub's login is the token).
HF_REPO=earakely-scale/CuaDriverBench-AgentEnv
