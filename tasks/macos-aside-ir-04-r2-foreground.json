  {"id": "grade", "type": "run_container_unit_tests_verifier", "sandbox_name": "grader", "container_name": "grade", "command": "python3 /grade/grade.py IR-04 722369", "reward_path": "/grade/reward.txt", "result_paths": ["/grade/result.json"], "depends_on": ["pack", "trial"]},
