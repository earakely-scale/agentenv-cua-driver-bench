[
  {"id": "env", "type": "deploy_env", "env_id": "desktop-s02-windows-codex-computer-use", "env_params": {"driver_settings": {"allowed_apps": null}, "app_settings": {"bench-sentinel": {"condition": "foreground"}}}},
  {"id": "arm_tools", "type": "modify_env_tool_access", "env_id": "desktop-s02-windows-codex-computer-use", "action": "disable", "role": "default", "tools": ["computer_click", "computer_drag", "computer_key", "computer_keyboard_down", "computer_keyboard_up", "computer_pointer_down", "computer_pointer_list", "computer_pointer_move", "computer_pointer_position", "computer_pointer_up", "computer_screenshot", "computer_scroll", "computer_type", "computer_wait"], "depends_on": ["env"]},
  {"id": "sandbox", "type": "deploy_sandbox", "sandbox_name": "grader", "sandbox_mode": "vm"},
  {"id": "box", "type": "run_docker_container", "sandbox_name": "grader", "docker_context_artifact_id": "grader", "dockerfile_path": "grader.Dockerfile", "container_name": "grade", "command_override": "sleep infinity", "network": "none", "depends_on": ["sandbox"]},
  {"id": "pack", "type": "load_artifact", "sandbox_name": "grader", "container_name": "grade", "artifact_id": "taskpack", "destination_path": "/grade/trycua", "depends_on": ["box"]},
  {"id": "agent", "type": "deploy_agent", "env_ids": ["desktop-s02-windows-codex-computer-use"], "builtin_tools": {"only": ["Skill", "Read"]}, "system_prompt": "You are an autonomous computer-use agent operating a Windows desktop through the tools provided. No human is available to answer questions or confirm actions; every action the task requires is pre-approved. Operate only the applications the task names. Do not use the network. When the task is done, reply with the single word DONE. If you cannot finish, reply BLOCKED and the reason.", "depends_on": ["env", "arm_tools"]},
  {"id": "skills", "type": "add_skills", "env_ids": ["desktop-s02-windows-codex-computer-use"], "depends_on": ["agent"]},
  {"id": "record", "type": "start_computer_recording", "env_id": "desktop-s02-windows-codex-computer-use", "name": "trial", "depends_on": ["env"]},
  {"id": "arm", "type": "run_code", "env_id": "desktop-s02-windows-codex-computer-use", "script_artifact_id": "sentinel", "args": {"action": "arm", "condition": "foreground"}, "depends_on": ["skills", "record"]},
  {"id": "task", "type": "prompt_agent", "prompt_id": "task", "prompt": "# Lighthouse program schedule replan\n\nReconcile the Lighthouse program schedule for October 14, 2026.\n\nRead the tentative request in Copperfield Mail and the later authoritative\nchange in Signal Quay Chat. Update `planning/lighthouse-replan.ods` in\nLibreOffice Calc and Daymark Calendar so their final schedules agree and every\nhard constraint is respected. Do not move or delete protected calendar holds.\n\nIf a requested session cannot be scheduled without violating a hard\nconstraint, leave it off the calendar, mark it blocked in the workbook, and\nrecord the structured blocker requested by the chat update. Preserve unrelated\nmessages, events, workbook controls, and records.\n\nFollow the workbook's Controls sheet exactly for status values, blank fields,\nand source citations. Scheduled calendar events use status `confirmed`.\n\nYour workspace directory is `C:\\Users\\user\\cdb-s02`.\n\nYou have about 6 minutes and at most 45 turns.\n", "timeout_seconds": 360, "max_turns": 45, "fail_task_on_error": false, "depends_on": ["arm"]},
  {"id": "disarm", "type": "run_code", "env_id": "desktop-s02-windows-codex-computer-use", "script_artifact_id": "sentinel", "args": {"action": "disarm"}, "fail_task_on_error": false, "depends_on": ["task"]},
  {"id": "end", "type": "end_computer_recording", "name": "trial", "depends_on": ["disarm"]},
  {"id": "snapshot", "type": "snapshot_env", "env_id": "desktop-s02-windows-codex-computer-use", "depends_on": ["disarm"]},
  {"id": "trial", "type": "load_artifact", "sandbox_name": "grader", "container_name": "grade", "artifact_from_step_id": "snapshot", "destination_path": "/grade/trial", "depends_on": ["box", "snapshot"]},
  {"id": "grade", "type": "run_container_unit_tests_verifier", "sandbox_name": "grader", "container_name": "grade", "command": "python3 /grade/grade.py", "reward_path": "/grade/reward.txt", "result_paths": ["/grade/result.json"], "depends_on": ["pack", "trial"]},
  {"id": "gui_only", "type": "env_outcome_verifier", "env_id": "desktop-s02-windows-codex-computer-use", "file_artifact_id": "gui_only", "verifier_id": "gui_only", "prompt_id": "task", "depends_on": ["disarm"]}
]
