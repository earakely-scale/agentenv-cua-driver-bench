[
  {"id": "env", "type": "deploy_env", "env_id": "desktop-benchlab-windows-agent-desktop", "env_params": {"driver_settings": {"headed": true}, "app_settings": {"benchlab": {"mode": "listdrag", "seed": 906853, "condition": "foreground"}, "bench-sentinel": {"condition": "foreground"}}}},
  {"id": "arm_tools", "type": "modify_env_tool_access", "env_id": "desktop-benchlab-windows-agent-desktop", "action": "disable", "role": "default", "tools": ["computer_click", "computer_drag", "computer_key", "computer_keyboard_down", "computer_keyboard_up", "computer_pointer_down", "computer_pointer_list", "computer_pointer_move", "computer_pointer_position", "computer_pointer_up", "computer_screenshot", "computer_scroll", "computer_type", "computer_wait"], "depends_on": ["env"]},
  {"id": "sandbox", "type": "deploy_sandbox", "sandbox_name": "grader", "sandbox_mode": "vm"},
  {"id": "box", "type": "run_docker_container", "sandbox_name": "grader", "docker_context_artifact_id": "grader", "dockerfile_path": "grader.Dockerfile", "container_name": "grade", "command_override": "sleep infinity", "network": "none", "depends_on": ["sandbox"]},
  {"id": "pack", "type": "load_artifact", "sandbox_name": "grader", "container_name": "grade", "artifact_id": "taskpack", "destination_path": "/grade/trycua", "depends_on": ["box"]},
  {"id": "agent", "type": "deploy_agent", "a2a_agent_id": "codex", "env_ids": ["desktop-benchlab-windows-agent-desktop"], "builtin_tools": {"disable": "*"}, "system_prompt": "You are an autonomous computer-use agent operating a Windows desktop through the tools provided. No human is available to answer questions or confirm actions; every action the task requires is pre-approved. Operate only the applications the task names. Do not use the network. When the task is done, reply with the single word DONE. If you cannot finish, reply BLOCKED and the reason.", "depends_on": ["env", "arm_tools"]},
  {"id": "skills", "type": "add_skills", "env_ids": ["desktop-benchlab-windows-agent-desktop"], "depends_on": ["agent"]},
  {"id": "record", "type": "start_computer_recording", "env_id": "desktop-benchlab-windows-agent-desktop", "name": "trial", "depends_on": ["env"]},
  {"id": "arm", "type": "run_code", "env_id": "desktop-benchlab-windows-agent-desktop", "script_artifact_id": "sentinel", "args": {"action": "arm", "condition": "foreground"}, "depends_on": ["skills", "record"]},
  {"id": "task", "type": "prompt_agent", "prompt_id": "task", "prompt": "BenchLab is already open on this Windows PC and shows a list of five tasks.\n\nReorder the list so that, from top to bottom, it reads:\n\n1. Print slides\n2. Test projector\n3. Share notes\n4. Update roster\n5. Draft agenda\n\nItems can only be reordered by dragging them. When the order is right, press the Done button below the list. Do not close BenchLab.\n\nYou have about 6 minutes and at most 45 turns.\n", "timeout_seconds": 360, "max_turns": 45, "fail_task_on_error": false, "depends_on": ["arm"], "effort": "medium"},
  {"id": "disarm", "type": "run_code", "env_id": "desktop-benchlab-windows-agent-desktop", "script_artifact_id": "sentinel", "args": {"action": "disarm"}, "fail_task_on_error": false, "depends_on": ["task"]},
  {"id": "end", "type": "end_computer_recording", "name": "trial", "depends_on": ["disarm"]},
  {"id": "snapshot", "type": "snapshot_env", "env_id": "desktop-benchlab-windows-agent-desktop", "depends_on": ["disarm"]},
  {"id": "trial", "type": "load_artifact", "sandbox_name": "grader", "container_name": "grade", "artifact_from_step_id": "snapshot", "destination_path": "/grade/trial", "depends_on": ["box", "snapshot"]},
  {"id": "grade", "type": "run_container_unit_tests_verifier", "sandbox_name": "grader", "container_name": "grade", "command": "python3 /grade/grade.py MB-09 906853", "reward_path": "/grade/reward.txt", "result_paths": ["/grade/result.json"], "depends_on": ["pack", "trial"]},
  {"id": "gui_only", "type": "env_outcome_verifier", "env_id": "desktop-benchlab-windows-agent-desktop", "file_artifact_id": "gui_only", "verifier_id": "gui_only", "prompt_id": "task", "depends_on": ["disarm"]}
]
