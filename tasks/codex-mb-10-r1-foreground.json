[
  {"id": "env", "type": "deploy_env", "env_id": "desktop-benchlab", "env_params": {"app_settings": {"benchlab": {"mode": "hover", "seed": 227159}, "bench-sentinel": {"condition": "foreground"}}}},
  {"id": "sandbox", "type": "deploy_sandbox", "sandbox_name": "grader", "sandbox_mode": "vm"},
  {"id": "box", "type": "run_docker_container", "sandbox_name": "grader", "docker_context_artifact_id": "grader", "dockerfile_path": "grader.Dockerfile", "container_name": "grade", "command_override": "sleep infinity", "network": "none", "depends_on": ["sandbox"]},
  {"id": "pack", "type": "load_artifact", "sandbox_name": "grader", "container_name": "grade", "artifact_id": "taskpack", "destination_path": "/grade/trycua", "depends_on": ["box"]},
  {"id": "agent", "type": "deploy_agent", "a2a_agent_id": "codex", "env_ids": ["desktop-benchlab"], "builtin_tools": {"disable": "*"}, "system_prompt": "You are an autonomous computer-use agent operating a Linux desktop through the tools provided. No human is available to answer questions or confirm actions; every action the task requires is pre-approved. Operate only the applications the task names. Do not use the network. When the task is done, reply with the single word DONE. If you cannot finish, reply BLOCKED and the reason.", "depends_on": ["env"]},
  {"id": "skills", "type": "add_skills", "env_ids": ["desktop-benchlab"], "depends_on": ["agent"]},
  {"id": "record", "type": "start_computer_recording", "env_id": "desktop-benchlab", "name": "trial", "depends_on": ["env"]},
  {"id": "arm", "type": "run_code", "env_id": "desktop-benchlab", "script_artifact_id": "sentinel", "args": {"action": "arm", "condition": "foreground"}, "depends_on": ["skills", "record"]},
  {"id": "task", "type": "prompt_agent", "prompt_id": "task", "prompt": "BenchLab is already open on your Mac. Along the top of its window there is a toolbar strip with an area labelled \"Actions\". The action buttons are not always on screen: they only show up while you point at that area.\n\nClick the \"Export\" button once. Do not click any other action button.\n\nDo not close BenchLab.\n\nYou have about 6 minutes and at most 45 turns.\n", "timeout_seconds": 360, "max_turns": 45, "fail_task_on_error": false, "depends_on": ["arm"], "effort": "medium"},
  {"id": "disarm", "type": "run_code", "env_id": "desktop-benchlab", "script_artifact_id": "sentinel", "args": {"action": "disarm"}, "fail_task_on_error": false, "depends_on": ["task"]},
  {"id": "end", "type": "end_computer_recording", "name": "trial", "depends_on": ["disarm"]},
  {"id": "snapshot", "type": "snapshot_env", "env_id": "desktop-benchlab", "depends_on": ["disarm"]},
  {"id": "trial", "type": "load_artifact", "sandbox_name": "grader", "container_name": "grade", "artifact_from_step_id": "snapshot", "destination_path": "/grade/trial", "depends_on": ["box", "snapshot"]},
  {"id": "grade", "type": "run_container_unit_tests_verifier", "sandbox_name": "grader", "container_name": "grade", "command": "python3 /grade/grade.py MB-10 227159", "reward_path": "/grade/reward.txt", "result_paths": ["/grade/result.json"], "depends_on": ["pack", "trial"]},
  {"id": "gui_only", "type": "env_outcome_verifier", "env_id": "desktop-benchlab", "file_artifact_id": "gui_only", "verifier_id": "gui_only", "prompt_id": "task", "depends_on": ["disarm"]}
]
